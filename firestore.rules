rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && (
        request.auth.token.role == 'SUPER_ADMIN' ||
        (
          request.auth.token.email == 'roboasaltante@gmail.com' &&
          request.auth.token.email_verified == true
        )
      );
    }
    function ownsDni(dni) {
      return signedIn() && (
        request.auth.token.dni == dni ||
        request.auth.token.email == dni + '@auth.murwy.local'
      );
    }

    match /users/{uid} {
      allow read: if isAdmin() || ownsDni(uid);
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        ownsDni(uid) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['requires_password_change', 'account_status', 'updated_at']) &&
        request.resource.data.requires_password_change == false &&
        request.resource.data.account_status == 'ACTIVO'
      );
    }
    match /companies/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /trainings/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /training_participants/{id} {
      allow read: if isAdmin() || ownsDni(resource.data.dni);
      allow write: if isAdmin();
    }
    match /confirmations/{id} {
      allow read: if isAdmin() || ownsDni(resource.data.dni);
      allow create: if ownsDni(request.resource.data.dni)
        && request.resource.data.keys().hasAll(['dni', 'training_id', 'confirmed_at', 'signature_blob'])
        && request.resource.data.signature_blob.size() <= 200000
        && exists(/databases/$(database)/documents/training_participants/$(request.resource.data.training_id + '_' + request.resource.data.dni));
      allow update, delete: if false;
    }
    match /consents/{id} {
      allow read: if isAdmin() || ownsDni(resource.data.dni);
      allow create: if ownsDni(request.resource.data.dni)
        && request.resource.data.keys().hasAll(['dni', 'version', 'accepted_at', 'signature_blob'])
        && request.resource.data.signature_blob.size() <= 200000;
      allow update, delete: if false;
    }
    match /authorized_signatures/{id} { allow read, write: if isAdmin(); }
    match /document_versions/{id} { allow read, write: if isAdmin(); }
    match /historical_documents/{id} { allow read, write: if isAdmin(); }
    match /audit_log/{id} {
      allow read: if isAdmin();
      allow create: if isAdmin();
      allow update, delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
