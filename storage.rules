rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function isAdmin() { return signedIn() && request.auth.token.role == 'SUPER_ADMIN'; }
    match /signatures/{dni}/{file=**} {
      allow read: if isAdmin() || (signedIn() && request.auth.token.dni == dni);
      allow write: if (isAdmin() || (signedIn() && request.auth.token.dni == dni))
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
    match /consents/{dni}/{file=**} {
      allow read: if isAdmin() || (signedIn() && request.auth.token.dni == dni);
      allow write: if signedIn() && request.auth.token.dni == dni
        && request.resource.size < 5 * 1024 * 1024;
    }
    match /records/{file=**} { allow read, write: if isAdmin(); }
    match /historical/{file=**} { allow read, write: if isAdmin(); }
    match /companies/{file=**} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
    match /{file=**} { allow read, write: if false; }
  }
}
